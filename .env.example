APP_NAME="Multi-Agent Book Writer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Use file cache so the project runs without a database.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# LLM provider
#   openai    -> OpenAI or any OpenAI-compatible endpoint
#   anthropic -> Anthropic Messages API
#   null      -> no network calls (used by the test suite)
#
# OpenRouter example:
#   AI_LLM_PROVIDER=openai
#   AI_LLM_BASE_URL=https://openrouter.ai/api/v1
#   AI_LLM_MODEL=openai/gpt-4o-mini
# ---------------------------------------------------------------------------
AI_LLM_PROVIDER=openai
AI_LLM_MODEL=openai/gpt-4o-mini
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://openrouter.ai/api/v1
AI_LLM_TEMPERATURE=0.3
AI_LLM_MAX_TOKENS=4000
AI_LLM_TIMEOUT=120
AI_LLM_RETRIES=2
AI_LLM_HTTP_REFERER=http://localhost:8000
AI_LLM_APP_TITLE=Multi-Agent Book Writer

# ---------------------------------------------------------------------------
# Web search provider
#   tavily     -> Tavily Search API (recommended). Returns page text fetched on
#                 their servers, which matters because NPCI/RBI/PIB block direct
#                 automated requests. Requires AI_SEARCH_API_KEY.
#   serper     -> https://google.serper.dev      (requires AI_SEARCH_API_KEY)
#   brave      -> Brave Search API               (requires AI_SEARCH_API_KEY)
#   duckduckgo -> keyless HTML search, no credentials needed
#   null       -> no network calls
# ---------------------------------------------------------------------------
AI_SEARCH_PROVIDER=tavily
AI_SEARCH_API_KEY=
AI_SEARCH_TIMEOUT=30
AI_SEARCH_RETRIES=2
AI_SEARCH_RESULTS_PER_QUERY=8
AI_SEARCH_MAX_FETCH_BYTES=400000
AI_SEARCH_MIN_TEXT=400

# Restrict search results to official domains (comma separated, optional).
# This is applied by Tavily server-side, so junk sources never reach the agent.
# Official sources first, reputable news outlets as a fallback. Leave blank to
# allow anything the search returns.
AI_TAVILY_INCLUDE_DOMAINS=npci.org.in,rbi.org.in,pib.gov.in,financialservices.gov.in,indiabudget.gov.in,udyogamitra.gov.in,data.gov.in,meity.gov.in,egazette.gov.in,worldbank.org,imf.org,reuters.com,pti.in,thehindu.com,economictimes.indiatimes.com,business-standard.com,livemint.com,moneycontrol.com
AI_TAVILY_EXCLUDE_DOMAINS=wikipedia.org,quora.com,medium.com,reddit.com
AI_TAVILY_DEPTH=advanced
AI_TAVILY_RAW_CONTENT=true

# ---------------------------------------------------------------------------
# Workflow
# ---------------------------------------------------------------------------
MAX_REVISIONS=2
CHAPTER_COUNT=3
MIN_CHAPTER_WORDS=600
MAX_CHAPTER_WORDS=900
MIN_SOURCES_PER_CHAPTER=4
MAX_SOURCES_PER_CHAPTER=8